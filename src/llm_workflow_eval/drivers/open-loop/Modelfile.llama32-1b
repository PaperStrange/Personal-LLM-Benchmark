# Modelfile for the open-loop stand-in model (llama3.2-1b-local).
#
# The GGUF weights (808 MB) are NOT committed to the repo. To provision:
#
#   1. Download the bartowski quantization into THIS directory:
#      curl -fsSL -o Llama-3.2-1B-Instruct-Q4_K_M.gguf \
#        https://huggingface.co/bartowski/Llama-3.2-1B-Instruct-GGUF/resolve/main/Llama-3.2-1B-Instruct-Q4_K_M.gguf
#      # expected sha256:
#      # 6f85a640a97cf2bf5b8e764087b1e83da0fdb51d7c9fab7d0fece9385611df83
#
#   2. Create the ollama model (once):
#      cd tools/open-loop && ollama create llama3.2-1b-local -f Modelfile.llama32-1b
#
# Provenance is also recorded per-run in results/open-loop-llama32-1b/runN-meta.json
# (model_provenance). License: Llama 3.2 Community License [SECONDARY].
FROM ./Llama-3.2-1B-Instruct-Q4_K_M.gguf
